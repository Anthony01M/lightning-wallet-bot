{
	"name": "lnwallet",
	"version": "1.0.0",
	"description": "A lightning network wallet discord bot, built with discord.js.",
	"author": "Anthony01M",
	"license": "Apache-2.0",
	"scripts": {
		"build": "rm -rf lib && esbuild \"src/**/*.ts\" --platform=node --sourcemap --ignore-annotations --format=cjs --target=es2022 --outdir=lib && esbuild src/index.ts --platform=node --sourcemap --ignore-annotations --format=cjs --target=es2022 --outdir=lib --banner:js=\"require('module-alias').addAlias('@', __dirname);\"",
		"kit": "drizzle-kit",
		"lint": "tsc",
		"dev": "pnpm build && cd lib && node --enable-source-maps index && cd .."
	},
	"engines": {
		"node": ">=22.9.0"
	},
	"keywords": [
		"lnwallet",
		"lightning",
		"bitcoin",
		"discord",
		"bot"
	],
	"dependencies": {
		"@rjweb/runtime-node": "^1.1.1",
		"@rjweb/sentry": "^2.1.5",
		"@rjweb/utils": "^1.12.29",
		"@sentry/node": "7.119.0",
		"ansi-colors": "^4.1.3",
		"axios": "^1.16.0",
		"discord.js": "^14.26.4",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.44.7",
		"ioredis": "^5.10.1",
		"module-alias": "^2.3.4",
		"node-cron": "^4.2.1",
		"pg": "^8.20.0",
		"rjweb-server": "^9.8.6",
		"ts-arithmetic": "^0.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.20.0",
		"esbuild": "^0.25.12",
		"typescript": "^5.9.3"
	}
}